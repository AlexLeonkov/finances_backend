generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Operation {
  id        Int      @id @default(autoincrement())
  invoiceNumber      String?
  team      String?
  members   String?
  date      DateTime
  revenue   Float
  materialCost Float?
  fuelCost Float?
  isPaid Boolean?
  profit    Float
  paymentAmount Float? @map("payment_amount")
  projectType String? @map("project_type")
  createdAt DateTime @default(now())
}

model FinanceDailyLedger {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId        String   @default("main") @map("account_id")
  ledgerDate       DateTime @db.Date @map("ledger_date")
  openingBalance   Decimal? @map("opening_balance")
  incomeInvoices   Decimal? @map("income_invoices")
  incomeOther      Decimal? @map("income_other")
  expenseMaterials Decimal? @map("expense_materials")
  expenseCar       Decimal? @map("expense_car")
  expenseRent      Decimal? @map("expense_rent")
  expenseSalaries  Decimal? @map("expense_salaries")
  expenseOther     Decimal? @map("expense_other")
  expenseMarketing Decimal? @map("expense_marketing")
  expenseHamburg   Decimal? @map("expense_hamburg")
  expenseInsurance Decimal? @map("expense_insurance")
  totalExpenses    Decimal? @map("total_expenses")
  closingBalance   Decimal? @map("closing_balance")
  source           String?
  sourceRowId      String?  @map("source_row_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("finance_daily_ledger")
}
